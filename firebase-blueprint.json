{
  "entities": {
    "ledger_account": {
      "title": "Ledger Account",
      "description": "Party or general ledger account (Customer, Vendor, Bank, Cash, Expense, Revenue)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "companyId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 120 },
        "group": { "type": "string", "enum": ["Sundry Debtors", "Sundry Creditors", "Bank Accounts", "Cash-in-hand", "Direct Expenses", "Indirect Expenses", "Sales Accounts", "Purchase Accounts", "Duties & Taxes"] },
        "contactPerson": { "type": "string", "maxLength": 100 },
        "gstin": { "type": "string", "maxLength": 20 },
        "pan": { "type": "string", "maxLength": 20 },
        "stateCode": { "type": "string", "maxLength": 5 },
        "phone": { "type": "string", "maxLength": 30 },
        "email": { "type": "string", "maxLength": 120 },
        "address": { "type": "string", "maxLength": 300 },
        "openingBalance": { "type": "number" },
        "currentBalance": { "type": "number" },
        "creditLimit": { "type": "number" },
        "notes": { "type": "string", "maxLength": 500 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "name", "group"]
    },
    "inventory_item": {
      "title": "Inventory Item",
      "description": "Stock products with HSN code, pricing, GST rates and current stock counts",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "companyId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 120 },
        "sku": { "type": "string", "maxLength": 60 },
        "hsnCode": { "type": "string", "maxLength": 20 },
        "unit": { "type": "string", "enum": ["Pcs", "Box", "Kg", "Mtr", "Ltr", "Set", "Bag", "Roll"] },
        "purchasePrice": { "type": "number" },
        "sellingPrice": { "type": "number" },
        "gstRate": { "type": "number" },
        "minStockAlert": { "type": "number" },
        "openingStock": { "type": "number" },
        "currentStock": { "type": "number" },
        "description": { "type": "string", "maxLength": 500 },
        "category": { "type": "string", "maxLength": 80 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "name", "sku", "hsnCode", "unit", "sellingPrice", "gstRate"]
    },
    "voucher": {
      "title": "Transaction Voucher",
      "description": "Day book transactions, invoices, bills, payments, receipts, credit/debit notes",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "companyId": { "type": "string", "maxLength": 128 },
        "voucherNo": { "type": "string", "maxLength": 50 },
        "date": { "type": "string", "maxLength": 35 },
        "type": { "type": "string", "enum": ["SALE", "PURCHASE", "PAYMENT", "RECEIPT", "CONTRA", "CREDIT_NOTE", "DEBIT_NOTE", "STOCK_TRANSFER"] },
        "partyId": { "type": "string", "maxLength": 128 },
        "partyName": { "type": "string", "maxLength": 120 },
        "customerMode": { "type": "string", "enum": ["existing", "new", "guest"] },
        "guestDetails": { "type": "object" },
        "isGstBill": { "type": "boolean" },
        "isGstInclusive": { "type": "boolean" },
        "paymentMode": { "type": "string", "enum": ["CASH", "BANK", "UPI", "CREDIT"] },
        "referenceNo": { "type": "string", "maxLength": 80 },
        "subtotal": { "type": "number" },
        "cgstTotal": { "type": "number" },
        "sgstTotal": { "type": "number" },
        "igstTotal": { "type": "number" },
        "roundOff": { "type": "number" },
        "grandTotal": { "type": "number" },
        "items": { "type": "array" },
        "receiptEntries": { "type": "array" },
        "journalEntries": { "type": "array" },
        "notes": { "type": "string", "maxLength": 1000 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "voucherNo", "date", "type", "grandTotal"]
    },
    "company_settings": {
      "title": "Company Settings",
      "description": "Business profile, GSTIN, bank details, theme, and custom invoice template preferences",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 120 },
        "gstin": { "type": "string", "maxLength": 20 },
        "state": { "type": "string", "maxLength": 50 },
        "stateCode": { "type": "string", "maxLength": 5 },
        "phone": { "type": "string", "maxLength": 30 },
        "email": { "type": "string", "maxLength": 120 },
        "address": { "type": "string", "maxLength": 300 },
        "bankName": { "type": "string", "maxLength": 100 },
        "accountNo": { "type": "string", "maxLength": 40 },
        "ifsc": { "type": "string", "maxLength": 20 },
        "branch": { "type": "string", "maxLength": 100 },
        "upiId": { "type": "string", "maxLength": 80 },
        "invoiceTerms": { "type": "string", "maxLength": 2000 },
        "paperSize": { "type": "string", "enum": ["A5", "A4"] },
        "showQrCode": { "type": "boolean" },
        "authorizedSignatoryTitle": { "type": "string", "maxLength": 120 },
        "themeColor": { "type": "string", "maxLength": 20 },
        "invoiceTemplate": { "type": "object" },
        "updatedBy": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "name"]
    }
  },
  "firestore": {
    "/ledgers/{ledgerId}": {
      "schema": "ledger_account",
      "description": "Chart of accounts, customers, companies/suppliers, and general ledger documents"
    },
    "/inventory/{itemId}": {
      "schema": "inventory_item",
      "description": "Stock products and inventory catalog"
    },
    "/vouchers/{voucherId}": {
      "schema": "voucher",
      "description": "Day book transactions, GST invoices, bills, and receipts"
    },
    "/settings/{settingId}": {
      "schema": "company_settings",
      "description": "Company profile, banking, and invoice template configuration"
    }
  }
}
